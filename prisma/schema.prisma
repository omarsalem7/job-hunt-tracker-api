generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStage {
  applied
  interview
  offer
  rejected
}

model Application {
  id          Int              @id @default(autoincrement())
  userId      Int
  company     String
  role        String
  stage       ApplicationStage @default(applied)
  notes       String?
  appliedDate DateTime         @default(now())
  contacts    Contact[]
  tags        Tag[] // Many-to-many back-relation
  lastFollowUpAt      DateTime?
  snoozeFollowUpUntil DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId,stage])
}

model Contact {
  id            Int      @id @default(autoincrement())
  userId        Int
  applicationId Int?
  name          String
  role          String?
  email         String?
  phone         String?
  linkedInUrl   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
}

model Tag {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name]) // A user cannot create two tags with the same name!
  @@index([userId])
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  contacts     Contact[]
  tags         Tag[]
  shareLinks   ShareLink[]  
}


model ShareLink{
   id          Int       @id @default(autoincrement())
   token       String    @unique @default(uuid()) // Secure unguessable token
   userId      Int
   user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
   // Optional controls
   includeNotes    Boolean   @default(false) // Hide private interview thoughts?
   includeContacts Boolean   @default(false) // Hide recruiter personal contacts?
   expiresAt       DateTime? // Link expires after 7 days, 30 days, etc.
   isActive        Boolean   @default(true)  // Instant revoke switch
  
   createdAt   DateTime  @default(now())
   updatedAt   DateTime  @updatedAt

  @@index([token])
  @@index([userId])
}
